# Автоопределение текстовых файлов и нормализация переводов строк
* text=auto

# Исходный код и разметка
*.cs text diff=csharp
*.xaml text
*.csproj text
*.json text
*.md text
*.sln text eol=crlf
*.slnx text

# Двоичные файлы: не сравнивать и не сливать
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.docx binary
*.db binary